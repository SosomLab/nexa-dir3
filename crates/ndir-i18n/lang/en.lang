pref.theme.desc = Color theme for the app — System follows the OS setting.
pref.lang.desc = Display language — System follows the OS language.
pref.termFont.desc = Terminal font. Comma-separated list becomes the fallback chain.
pref.termFontSize.desc = Terminal font size in DIP (8~32).
pref.dlgFont.desc = Font for dialogs (confirmations, progress).
pref.dlgFontSize.desc = Dialog font size in points (7~24).
pref.showHidden.desc = Show a hidden file or folder (on Linux and macOS, items whose name starts with a dot). This is the default for new tabs; open tabs keep their own value, changed with the toolbar or View menu toggle.
pref.showDotfiles.desc = Show a file or folder whose name starts with a dot. This is the default for new tabs; open tabs keep their own value, changed with the toolbar or View menu toggle.
pref.showProtected.desc = Show items protected by the operating system (Windows: hidden + system attributes — $RECYCLE.BIN, pagefile.sys, … / macOS: hidden + system-protected items / Linux: not applicable). When off, they stay hidden even if hidden files are shown.
pref.colAutofitMax = Column auto-fit max width (50-2000)
pref.colAutofitMax.desc = Maximum width in pixels when double-clicking a column border to auto-fit contents.
pref.toolbarOrder = Toolbar Order
pref.toolbarOrder.desc = Reorder toolbar buttons. Select a group or an item, then use the up/down buttons - groups move as a whole, items move within their group (Shift-click = contiguous multi-select).
pref.tbo.grpPanel = Panel Controls
pref.tbo.grpView = View Mode
pref.tbo.grpShow = Visibility
pref.tbo.panelToggle = File Panel Toggle
pref.tbo.infoToggle = Info Panes Toggle
pref.editBtn = Edit...
pref.colLayout = File Columns
pref.colLayout.desc = Show/hide and reorder file list columns in a separate window (applies to the focused panel; follows column sync).
pref.iconOverrides = Custom Icons
pref.iconOverrides.desc = Your own icons for the file list, highest priority. Rules separated by ';' in the form kind:pattern=image - kind is path (full path), name (file or folder name), dir (folder name) or ext (extension). Images: PNG/BMP/GIF/JPEG; relative paths are looked up in the icons folder of the settings folder. Example: ext:rs=rust.png; dir:node_modules=nm.png
pref.rowIcons = Icons before file names
pref.rowIcons.desc = Show a type icon before each name in the file list. When off, icons are neither looked up nor drawn (always off in performance mode).
pref.folderSize = Calculate folder size in the info pane
pref.folderSize.desc = When a single folder is selected, the info pane computes its total size and the number of files and folders in the background. Large folders take time and read the disk. When off, nothing is computed (always off in performance boost mode).
pref.folderSizeThreads = Folder size: concurrent jobs
pref.folderSizeThreads.desc = How many folders are measured at once. Selecting many folders in a row queues the requests; only this many run at a time and the next one starts when one finishes (limits disk and CPU use). The folder you are looking at is at the front of the queue.
pref.folderSizeQueue = Folder size: queue limit
pref.folderSizeQueue.desc = Upper bound of folders waiting their turn. Beyond it the oldest requests are dropped.
pref.folderSizeSettle = Folder size: settle time (ms)
pref.folderSizeSettle.desc = When moving quickly through folders with the keyboard or scrolling, a request that comes sooner than this after the previous selection is not queued; only the last folder is measured once you stop (no work is created for folders you passed). 0 = always immediately.
pref.toolbarSize = Toolbar icon size
pref.toolbarSize.desc = Size of the top toolbar icons. Applied immediately.
pref.toolbarSize.16 = 16 (small)
pref.toolbarSize.20 = 20 (default)
pref.toolbarSize.24 = 24 (large)
pref.toolbarSize.32 = 32 (extra large)
pref.toolbarIconPad = Toolbar: padding around icons (px)
pref.toolbarIconPad.desc = Extra space on all four sides of each toolbar icon. 1 = icons are 2 px apart and the toolbar is 2 px taller.
pref.toolbarHoverFill = Toolbar: hover fill (%)
pref.toolbarHoverFill.desc = Strength of the soft background shown when the pointer is over a toolbar button.
pref.toolbarOnFill = Toolbar: toggled fill (%)
pref.toolbarOnFill.desc = Strength of the accent background of a toggled-on toolbar button.
pref.toolbarOnLine = Toolbar: toggled border (%)
pref.toolbarOnLine.desc = Strength of the 1 px accent border of a toggled-on toolbar button.
pref.toolbarStateStep = Toolbar: hover/press step (%)
pref.toolbarStateStep.desc = How much stronger a toggled button gets on hover, and again when pressed.
pref.toolbarStateRadius = Toolbar: state corner radius (px)
pref.toolbarStateRadius.desc = Corner radius of the hover/toggled background.
pref.toolbarOnIconAccent = Toolbar: accent-colored icon when toggled
pref.toolbarOnIconAccent.desc = Draw the icon of a toggled-on toolbar button in the accent color. Off = keep the normal icon color (clearer on the accent background).
pref.toolbarItemGap = Toolbar: gap between icons (px)
pref.toolbarItemGap.desc = Space between icons inside a toolbar group. 0 = icons touch.
pref.toolbarGroupGap = Toolbar: gap between groups (px)
pref.toolbarGroupGap.desc = Space between toolbar groups (each group has a grip you can drag to move it).
pref.toolbarRowGap = Toolbar: gap between rows (px)
pref.toolbarRowGap.desc = Space between toolbar rows when groups are arranged on more than one row. Changes the toolbar height.
pref.toolbarDockLayout = Toolbar group arrangement
pref.toolbarDockLayout.desc = Order and rows of the toolbar groups (saved when you drag a group).
pref.launcherSize = Quick launcher icon size
pref.launcherSize.desc = Size of the quick launcher bar icons. Applied immediately; the bar height follows.
pref.launcherItemGap = Quick launcher: gap between icons (px)
pref.launcherItemGap.desc = Space between icons in the quick launcher bar. 0 = icons touch.
pref.menuWrap = Wrap-around menu navigation
pref.menuWrap.desc = When moving through a menu with the Up/Down keys, Down on the last item jumps to the first and Up on the first item jumps to the last. When off, movement stops at both ends.
pref.menuChar = Pick menu items by letter key
pref.menuChar.desc = While a menu is open, pressing a letter goes to the item that starts with it. A single match runs immediately; several matches cycle with each press. When off, letter keys close the menu.
pref.hashAlgos = Checksum algorithms
pref.hashAlgos.desc = Algorithms the checksum window computes (comma-separated: crc32, md5, sha1, sha256, sha512). The file is read once for all of them, so more algorithms do not mean more disk reads. Default crc32,md5,sha1,sha256.
pref.hashAutoLimit = Checksum auto-calculate limit (MB, 0 = always manual)
pref.hashAutoLimit.desc = The checksum window starts calculating automatically only when the selected files total at most this size. Above it you press Calculate; 0 means always manual. Calculation runs one job at a time on a low-priority thread.
pref.menuIcons = Icons before menu items
pref.menuIcons.desc = Show icons before items in context menus and the menu bar (always off in performance mode).
pref.ctxPrebuild = Prepare the context menu in advance
pref.ctxPrebuild.desc = When a selection rests for a moment, build the OS shell menu ahead of time so the right-click menu opens instantly. Off: the menu is built on right-click (1-3 s on PCs with many shell extensions), but merely selecting files no longer loads shell extensions (tens of MB).
pref.ctxShell = Shell extension items in the context menu
pref.ctxShell.desc = When to include items from OS shell extensions (7-Zip, cloud drives, antivirus, …) in the right-click menu. Once loaded, extensions stay until the program exits and keep memory (tens of MB), threads and handles. With "Only on Shift+right-click" the normal menu opens instantly with built-in items only; hold Shift while right-clicking when you need the shell items.
pref.ctxShell.always = Always
pref.ctxShell.shift = Only on Shift+right-click
pref.ctxShell.never = Never
pref.ctxMenuOrder = Context Menu Items
pref.ctxMenuOrder.desc = Show/hide and reorder the app's own context menu items (shell verbs are not affected).
pref.ctxm.grpRow = Item Menu
pref.ctxm.grpBg = Background Menu
pref.ctxm.grpXdg = Shell items (item menu)
pref.ctxm.grpXdgBg = Shell items (background menu)
pref.dock.desc = Show the bottom dock (info, preview, terminal).
pref.sortFoldersFirst = Sort folders first
pref.sortFoldersFirst.desc = Group folders before files regardless of sort order. This is the default for new tabs; open tabs keep their own value, changed with the toolbar toggle.
pref.hideEmptyGlyph = Hide expand glyph for empty folders
pref.hideEmptyGlyph.desc = Hide the tree expand glyph when a folder has nothing to show under the current view (hidden/dot filters). Re-appears when the view options reveal content.
pref.viewScope = View options scope
pref.viewScope.desc = How far the hidden/dot/folders-first/case-sensitive/natural-sort toggles in the toolbar and View menu reach. All = every tab in both panels; Left/right panel = every tab in that panel; Tab = that tab only; Folder = tabs showing the same folder change together in either panel, and each folder remembers its own values. The checkboxes in this window only set the default for new tabs (folders with nothing remembered).
pref.viewScope.global = All
pref.viewScope.panel = Left/right panel
pref.viewScope.tab = Tab
pref.viewScope.dir = Folder
pref.termWrap = Terminal word wrap
pref.termWrap.desc = Wrap lines to the view width. Off = fixed columns with horizontal scroll.
pref.termCols = Terminal columns (80~1000)
pref.termCols.desc = Fixed column count when word wrap is off. Scroll horizontally with Shift+wheel.
pref.termTheme = Terminal theme
pref.termTheme.desc = System follows the app theme using the dark/light defaults below. Picking a specific theme pins it regardless of the app theme (a light terminal in dark mode works too).
pref.termTheme.system = System (follow app theme)
pref.termTheme.dark = Dark default theme
pref.termTheme.light = Light default theme
pref.termThemeDark = Default terminal theme in dark mode
pref.termThemeDark.desc = Used when the app is dark (or when "Dark default theme" is selected above).
pref.termThemeLight = Default terminal theme in light mode
pref.termThemeLight.desc = Used when the app is light (or when "Light default theme" is selected above).
pref.termCopy = Text format to copy to the clipboard
pref.termCopy.desc = Formats added when copying a terminal selection with Ctrl+C. Plain text is always included.
pref.termCopy.text = Plain text only
pref.termCopy.html = HTML
pref.termCopy.rtf = RTF
pref.termCopy.both = Both HTML and RTF
pref.sortCaseSensitive = Case-sensitive sort
