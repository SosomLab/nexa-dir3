    <iconUrl>https://cdn.jsdelivr.net/gh/SosomLab/nexa-dir3@v@VERSION@/packaging/branding/nexa-dir-256.png</iconUrl>
    <licenseUrl>https://github.com/SosomLab/nexa-dir3/blob/main/LICENSE.md</licenseUrl>
